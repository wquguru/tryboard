[
 {
  "id": "s3-hello",
  "chip": "esp32s3",
  "seconds": 3,
  "expect": [
   "Hello world!",
   "This is esp32s3 chip",
   "16MB flash",
   "took 4999",
   "TRYBOARD_OK s3-hello"
  ],
  "qemu": true,
  "qemu_skip": [
   "took 4999"
  ]
 },
 {
  "id": "hello",
  "seconds": 3,
  "expect": [
   "Hello world!",
   "4MB flash",
   "revision v0.4",
   "TRYBOARD_OK hello"
  ],
  "qemu": true
 },
 {
  "id": "blink",
  "seconds": 2.2,
  "expect": [
   "LED ON  (0)",
   "LED OFF (3)",
   "TRYBOARD_OK blink"
  ],
  "gpio_toggles": {
   "pin": 5,
   "min": 4
  }
 },
 {
  "id": "button",
  "seconds": 1.5,
  "script": "0.5:gpio9=0; 0.6:gpio9=z; 1.0:gpio9=0; 1.1:gpio9=z",
  "expect": [
   "BUTTON PRESSED 1",
   "BUTTON PRESSED 2",
   "TRYBOARD_OK button"
  ],
  "gpio_toggles": {
   "pin": 5,
   "min": 2
  }
 },
 {
  "id": "echo",
  "seconds": 1,
  "script": "0.3:uart=hello tryboard\\n; 0.6:uart=ping\\n",
  "expect": [
   "ECHO: hello tryboard",
   "pong",
   "TRYBOARD_OK echo"
  ]
 },
 {
  "id": "fade",
  "seconds": 3.6,
