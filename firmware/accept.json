 {
  "id": "bench",
  "seconds": 5,
  "expect": [
   "primes=3512 crc=694b5a42 sum=1.644725",
   "TRYBOARD_OK bench"
  ]
 },
 {
  "id": "oled",
  "seconds": 2.5,
  "args": [
   "--i2c",
   "ssd1306@0x3c"
  ],
  "expect": [
   "I2C scan (SDA=GPIO6, SCL=GPIO7): 0x3C  (1 device)",
   "SSD1306 init OK",
   "TRYBOARD_OK oled",
   "frame 1 flushed"
  ],
  "numeric": [
   {
    "name": "1KB 帧传输耗时(us)",
    "regex": "flushed in (\\d+) us",
    "value": 23500,
    "tol": 2500
   }
  ],
  "oled_min_pixels": 1000
 },
 {
  "id": "bme280",
  "seconds": 4.5,
  "args": [
   "--i2c",
   "bme280@0x76",
   "--env",
   "-7.25,88.5,95012"
  ],
  "expect": [
   "I2C scan (SDA=GPIO6, SCL=GPIO7): 0x76",
   "chip id 0x60 OK",
   "TRYBOARD_OK bme280"
  ],
  "numeric": [
   {
    "name": "温度",
    "regex": "T=(-?[\\d.]+) C",
    "value": -7.25,
    "tol": 0.02
   },
   {
    "name": "湿度",
    "regex": "H=([\\d.]+) %",
    "value": 88.5,
    "tol": 0.1
   },
   {
    "name": "气压",
    "regex": "P=([\\d.]+) hPa",
    "value": 950.12,
    "tol": 0.02
   }
  ]
 },
 {
  "id": "wifi-init",
  "seconds": 3,
  "expect": [
   "wifi_init ok",
   "TRYBOARD_OK wifi-init",
   "start ok"
  ]
 },
 {
  "id": "wifi-scan",
  "seconds": 4,
  "expect": [
   "找到 4 个 AP",
   "AP TryBoard-WiFi    ch= 6 rssi= -42 auth=OPEN",
   "AP TryBoard-WPA2    ch= 1 rssi= -55 auth=WPA2_PSK",
   "AP Neighbor-5G-Ext  ch=11 rssi= -78 auth=WPA2_PSK",
   "TRYBOARD_OK wifi-scan"
  ]
 },
 {
  "id": "wifi-connect",
  "seconds": 4,
  "expect": [
   "已连接 TryBoard-WiFi ch=6",
   "拿到 IP 192.168.4.100 网关 192.168.4.1 掩码 255.255.255.0",
   "TRYBOARD_OK wifi-connect"
  ]
 },
 {
  "id": "wifi-http",
  "seconds": 4,
  "expect": [
   "GET http://tryboard.local/hello.txt → 200，17 字节",
   "正文：TRYBOARD_HTTP_OK",
   "GET http://example.com/api/time → 200",
   "TRYBOARD_OK wifi-http"
  ]
 },
 {
  "id": "nvs",
  "seconds": 3,
  "expect": [
   "开机第 1 次",
   "开机第 2 次（复位原因 3）",
   "开机第 3 次",
   "TRYBOARD_OK nvs"
  ]
 },
 {
  "id": "arduino-blink",
  "seconds": 2.5,
  "expect": [
   "Arduino blink start",
   "LED ON (1)",
   "TRYBOARD_OK arduino-blink"
  ],
  "gpio_toggles": {
   "pin": 5,
   "min": 3
  }
 },
 {
  "id": "s3-usb-keyboard",
  "chip": "esp32s3",
  "seconds": 4,
  "args": [
   "--usb-log"
  ],
  "expect": [
   "USB 已连接",
   "TRYBOARD_OK usb-keyboard"
  ],
  "stderr_expect": [
   "USB 主机：已配置",
   "VID 0x303A PID 0x4004",
   "\"TryBoard Keyboard\"",
   "报告 1=键盘，报告 2=鼠标",
   "USB 键盘输入: \"Hello from TryBoard!\\n\"",
   "USB 鼠标报告 80 次，位置 (0, 0)"
  ]
 },
 {
  "id": "s3-usb-cdc",
  "chip": "esp32s3",
  "seconds": 2,
  "args": [
   "--usb-log"
  ],
  "script": "1.0:usbcdc=hello\\n; 1.3:usbcdc=ping\\n",
  "expect": [
   "USB 已连接",
   "CDC 收到：hello",
   "TRYBOARD_OK usb-cdc"
  ],
  "stderr_expect": [
   "CDC-ACM 控制接口",
   "SET_CONTROL_LINE_STATE DTR=1",
   "USB 串口收到: \"Hi from TryBoard CDC\\r\\nECHO: HELLO\\r\\nECHO: PING\\r\\n\""
  ]
 }
]