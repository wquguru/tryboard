CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# micro-opus defaults to floating point on S3: SILK encoding is 7.7x slower and misses real time (RS-2 section 10)
CONFIG_OPUS_FLOATING_POINT=n
CONFIG_OPUS_ENABLE_XTENSA_OPTIMIZATIONS=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Octal PSRAM (N16R8 module): micro-opus puts its 120 KB pseudostack and codec state there
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Wi-Fi + WebSocket + Opus need more than the default 1 MB app partition
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
